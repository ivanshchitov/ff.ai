# Облачная модель (OpenCode Zen). Ключ нужен только облачным моделям:
# при запуске без ключа приложение работает и предлагает ввести его перед первым облачным вопросом.
OPENCODE_API_KEY=sk-ваш_ключ
# OPENCODE_API_URL=https://opencode.ai/zen/v1/chat/completions

# Локальная модель llama.cpp (embedded-модель ищем на том же сервере по /v1/embeddings)
# FFAI_LOCAL_API_URL=http://127.0.0.1:9999/v1/chat/completions

# Домен (область применимости). По умолчанию определяется по маркерам целевого репозитория.
# FFAI_DOMAIN=aurora-qt5
# FFAI_REPO_ROOT=/path/to/aurora-project

# Состояние пользователя: по умолчанию вне репозитория — $XDG_DATA_HOME/ff-ai
# FFAI_STATE_DIR=/path/to/data/ff-ai
# FFAI_HISTORY_FILE=/path/to/data/ff-ai/history.json
# FFAI_MEMORY_FILE=/path/to/data/ff-ai/memory.json
# FFAI_PROFILE_FILE=/path/to/data/ff-ai/profile.json
# FFAI_TASK_FILE=/path/to/data/ff-ai/task.json
# FFAI_SCHEDULE_FILE=/path/to/data/ff-ai/schedule.json
# FFAI_TASKS_DIR=/path/to/data/ff-ai/tasks
# FFAI_EXPORTS_DIR=/path/to/data/ff-ai/reports

# Кэш и индекс: по умолчанию $XDG_CACHE_HOME/ff-ai/<хеш пути репозитория>
# FFAI_CACHE_DIR=/path/to/cache/ff-ai
# FFAI_INDEX_FILE=/path/to/cache/ff-ai/index.sqlite3

# MCP: переопределение реестра целиком (тесты и демонстрации; в обычном запуске
# серверы берутся из пакета домена и из кода приложения)
# FFAI_MCP_URL=http://127.0.0.1:8000/mcp
# FFAI_MCP_NAME=aurora-docs
# FFAI_MCP_COMMAND=python3
# FFAI_MCP_ARGS=-m tests.fake_mcp_server
# FFAI_MCP_TIMEOUT=60

# Корпус документации портала (P4)
# FFAI_DOCS_SEARCH_LIMIT=5
# FFAI_DOCS_MAX_FRAGMENTS=3
# FFAI_DOCS_FRAGMENT_CHARS=1500
# FFAI_DOCS_SNIPPET_CHARS=400
# FFAI_DOCS_RETRIEVAL_MODE=enhanced
# FFAI_DOCS_RELEVANCE_THRESHOLD=0.6
# FFAI_DOCS_RERANK_MAX_WORDS=2000
# FFAI_DOCS_CITATION_MIN_CHARS=20
# FFAI_DOCS_CITATION_RETRIES=1

# Корпус кода целевого репозитория (P2)
# FFAI_CODE_RETRIEVAL_MODE=enhanced
# FFAI_CODE_RELEVANCE_THRESHOLD=0.6
# FFAI_CODE_CANDIDATES_BEFORE=20
# FFAI_CODE_FRAGMENTS_AFTER=3
# FFAI_CODE_SNIPPET_CHARS=1200
# FFAI_CODE_FRAGMENT_MAX_CHARS=4000
# FFAI_CODE_RERANK_MAX_WORDS=2000
# FFAI_CODE_QUERY_MAX_WORDS=200
# FFAI_CODE_CITATION_MIN_CHARS=40

# Автовызов инструментов MCP (P5)
# FFAI_AUTO_TOOLS=1
# FFAI_TOOL_CHOICE_MAX_WORDS=2000
# FFAI_TOOL_CHAIN_MAX_STEPS=4
# FFAI_TOOL_FLOW_MAX_ROUNDS=6
# FFAI_TOOL_FLOW_MAX_STEPS=10
# FFAI_TOOL_FLOW_CONTEXT_CHARS=24000
# FFAI_TOOL_FLOW_OLD_RESULT_CHARS=1500
# FFAI_TOOL_ANSWER_RESULT_CHARS=6000

# Задача с проверкой (P6)
# FFAI_TASK_PLAN_MAX_WORDS=400
# FFAI_TASK_PATCH_MAX_WORDS=1500
# FFAI_TASK_VALIDATE_MAX_WORDS=500
# FFAI_TASK_GOAL_MAX_CHARS=400
# FFAI_TASK_RESULT_SLUG_MAX_CHARS=40
# FFAI_MAX_PLAN_ITEMS=10
# FFAI_MAX_PLAN_ROUNDS=5
# FFAI_MAX_VALIDATION_ATTEMPTS=3
# FFAI_INVARIANT_RETRIES=1
# FFAI_MAX_TRANSITION_LOG=20

# Локальная модель llama.cpp (P10): сервер поднимает и останавливает само приложение
# FFAI_LLAMA_AUTOSTART=1
# FFAI_LLAMA_START_TIMEOUT=120

# Поведение
# FFAI_REQUEST_TIMEOUT=90
# FFAI_TYPING_DELAY=0.004
# FFAI_COMPRESS_AFTER=10
# FFAI_MAX_SESSION_TOKENS=20000
