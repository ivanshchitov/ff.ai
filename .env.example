# Облачная модель (OpenCode Zen). Ключ нужен только облачным моделям:
# при запуске без ключа приложение работает и предлагает ввести его перед первым облачным вопросом.
OPENCODE_API_KEY=sk-ваш_ключ
# OPENCODE_API_URL=https://opencode.ai/zen/v1/chat/completions

# Локальная модель llama.cpp (embedded-модель ищем на том же сервере по /v1/embeddings)
# FFAI_LOCAL_API_URL=http://127.0.0.1:9999/v1/chat/completions

# Домен (область применимости). По умолчанию определяется по маркерам целевого репозитория.
# FFAI_DOMAIN=aurora-qt5
# FFAI_REPO_ROOT=/path/to/aurora-project

# Состояние пользователя: по умолчанию вне репозитория — $XDG_DATA_HOME/ff-ai
# FFAI_STATE_DIR=/path/to/data/ff-ai
# FFAI_HISTORY_FILE=/path/to/data/ff-ai/history.json
# FFAI_MEMORY_FILE=/path/to/data/ff-ai/memory.json
# FFAI_PROFILE_FILE=/path/to/data/ff-ai/profile.json
# FFAI_TASK_FILE=/path/to/data/ff-ai/task.json
# FFAI_SCHEDULE_FILE=/path/to/data/ff-ai/schedule.json
# FFAI_TASKS_DIR=/path/to/data/ff-ai/tasks
# FFAI_EXPORTS_DIR=/path/to/data/ff-ai/reports

# Кэш и индекс: по умолчанию $XDG_CACHE_HOME/ff-ai/<хеш пути репозитория>
# FFAI_CACHE_DIR=/path/to/cache/ff-ai
# FFAI_INDEX_FILE=/path/to/cache/ff-ai/index.sqlite3

# Поведение
# FFAI_REQUEST_TIMEOUT=90
# FFAI_TYPING_DELAY=0.004
# FFAI_COMPRESS_AFTER=10
# FFAI_MAX_SESSION_TOKENS=20000
