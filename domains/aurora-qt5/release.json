{
  "schema": 1,
  "metadata": [
    {
      "glob": "**/*.spec",
      "required": [
        "(?m)^Name:[ \\t]*\\S+",
        "(?m)^Version:[ \\t]*\\S+",
        "(?m)^Release:[ \\t]*\\S+",
        "(?m)^License:[ \\t]*\\S+",
        "(?m)^BuildRequires:[ \\t]*\\S+"
      ],
      "identity_pattern": "(?m)^Name:[ \\t]*([^\\s]+)[ \\t]*$"
    },
    {
      "glob": "**/*.desktop",
      "required": [
        "(?m)^\\[Desktop Entry\\][ \\t]*$",
        "(?m)^Type=Application[ \\t]*$",
        "(?m)^Name=\\S+",
        "(?m)^Exec=/usr/bin/\\S+",
        "(?m)^Icon=\\S+",
        "(?m)^\\[X-Application\\][ \\t]*$",
        "(?m)^Permissions=.*$",
        "(?m)^OrganizationName=\\S+",
        "(?m)^ApplicationName=\\S+"
      ],
      "identity_pattern": "(?m)^Exec=/usr/bin/([^\\s]+)(?:[ \\t]+[^\\r\\n]*)?$"
    }
  ],
  "build_required": true,
  "target_pattern": "AuroraOS-*-{arch}",
  "build_command": ["-c", "no-pull-build-requires", "build", "{project}"],
  "tests_required": false,
  "test_command": []
}
